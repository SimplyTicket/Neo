{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./js",
    "rootDir": "./ts",
    "baseUrl": ".",
    "paths": {
      "@/*": ["ts/*"]
    }
  },
  "include": ["ts/**/*.ts"]
}
